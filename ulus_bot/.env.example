# ULUS Security Bot ayarları — main.py ile aynı klasörde ".env" adıyla durmalı.
# Boş bırakılan değerler parantezdeki varsayılanı kullanır.

# @BotFather'dan alınan bot token (ZORUNLU)
BOT_TOKEN=
# Bot sahibinin Telegram kullanıcı ID'si (/id ile öğrenilir)
FOUNDER_ID=

# İsteğe bağlı Telethon (my.telegram.org). İkisi de doluysa Telethon başlar, yoksa kapalı kalır.
API_ID=
API_HASH=
# Telethon oturum dosyası (ulus_userbot)
TELETHON_SESSION=

# SQLite veritabanı (bot_data.db). Göreli yollar main.py'nin klasörüne göre çözülür.
DB_FILE=
# Yedek klasörü (backups)
BACKUP_DIR=
# Saklanacak yedek sayısı (7)
BACKUP_KEEP=
# Günlük yedeğin gönderileceği sohbet ID'si (FOUNDER_ID)
BACKUP_CHAT_ID=

# DEBUG / INFO / WARNING / ERROR (INFO)
LOG_LEVEL=
