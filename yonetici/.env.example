# yonetici/.env  (chmod 600) — bu dosya git'e EKLENMEZ

# --- Telegram ---
MAIN_BOT_TOKEN=123456789:AA...
# Silinemeyen sahip hesap(lar); virgülle ayrılmış kullanıcı ID'leri
OWNER_IDS=123456789
WEB_HOST=kullaniciadi.pythonanywhere.com
# Webhook gizli başlığı: 1-256 karakter, sadece A-Z a-z 0-9 _ -
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- MySQL (PythonAnywhere → Databases) ---
DB_BACKEND=mysql
MYSQL_HOST=kullaniciadi.mysql.pythonanywhere-services.com
MYSQL_USER=kullaniciadi
MYSQL_PASSWORD=
MYSQL_DB=kullaniciadi$botyonetici

# --- Alt botlar (isteğe bağlı) ---
# Alt bot venv'lerini oluşturacak Python; boşsa supervisor'ı çalıştıran Python
# BOT_PYTHON=/usr/bin/python3.11
DEFAULT_RAM_MB=256
MAX_RAM_MB=2048
# AS: sanal bellek (varsayılan, katı). Çok thread açan bir bot başlarken
# "can't start new thread" alırsa DATA (heap) moduna geçin.
RAM_LIMIT_MODE=AS
BOT_NICE=10
STOP_TIMEOUT=10
# PythonAnywhere planınızdaki disk kotası (MB) — panelde doluluk çubuğu için
DISK_QUOTA_MB=5000
