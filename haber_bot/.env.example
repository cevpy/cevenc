# ULUS Haber Botu ayarları. Boş bırakılan değerler varsayılanı kullanır.

# @BotFather'dan alınan bot anahtarı (zorunlu)
BOT_TOKEN=
# Senin Telegram kullanıcı ID'n (istatistik, kaynak durumu ve duyuru komutları için)
FOUNDER_ID=
# Veritabanı dosyası (varsayılan: main.py'nin yanında haber_bot.db)
DB_FILE=
# Normal kaynakların kaç saniyede bir yenileneceği (varsayılan 300, en az 60). Son dakika akışları 2 dakikada bir.
FETCH_INTERVAL=
# Haberlerin kaç gün saklanacağı (varsayılan 7)
KEEP_DAYS=
# DEBUG / INFO / WARNING (varsayılan INFO)
LOG_LEVEL=
